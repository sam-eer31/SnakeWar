# =============================================================================
# SNAKEWAR PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================

# Dedicated WebSocket Server URL for Public Multiplayer Arenas
# On Local Development: ws://localhost:3001
# On Render / Production: wss://<your-render-service-name>.onrender.com
NEXT_PUBLIC_SERVER_URL=https://snakewar-server.onrender.com

# Cloudflare Workers Edge Relay for Player-Hosted Custom Arenas (Host-Authoritative)
# On Local Development: localhost:1999
# On Cloudflare Production: snakewar.<your-subdomain>.workers.dev
NEXT_PUBLIC_PARTYKIT_HOST=localhost:1999
